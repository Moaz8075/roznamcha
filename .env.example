# Database — Neon (recommended) or local Postgres
# Pooled URL for the API; direct URL for Prisma migrate (no -pooler host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Local fallback:
# DATABASE_URL="postgresql://roznamcha:roznamcha@localhost:5432/roznamcha?schema=public"
# DIRECT_URL="postgresql://roznamcha:roznamcha@localhost:5432/roznamcha?schema=public"

# JWT Authentication
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# API
API_PORT=3001
NODE_ENV=development

# Mobile / clients — leave unset to auto-use the Expo/Metro host IP on device.
# Override only when needed, e.g. http://192.168.1.10:3001/api/v1
# EXPO_PUBLIC_API_URL="http://192.168.1.10:3001/api/v1"
