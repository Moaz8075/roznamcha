# Database — Neon or local Postgres
# On Render + Neon, add connect_timeout so cold starts don't fail (P1001)
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Local:
DATABASE_URL="postgresql://roznamcha:roznamcha@localhost:5432/roznamcha?schema=public"

# JWT Authentication
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# API
API_PORT=3001
NODE_ENV=development

# Mobile / clients
# EXPO_PUBLIC_API_URL="https://roznamcha.onrender.com/api/v1"
