{
  "name": "Roznamcha",
  "slug": "roznamcha",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "scheme": "roznamcha",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#FFFFFF"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.roznamcha.app"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    },
    "package": "com.roznamcha.app",
    "usesCleartextTraffic": true
  },
  "plugins": ["expo-router", "expo-secure-store"],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {
      "origin": false
    }
  }
}
